# ============ Phase 1 ============
DATABASE_URL=sqlite+aiosqlite:///./data/edgefall.db
# DATABASE_URL=postgresql+asyncpg://edgesys:password@localhost:5432/edgesys  # Phase 2 生产
JWT_SECRET_KEY=change-this-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ============ Phase 2 ============
# 大模型（阿里云 DashScope）
QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL_NAME=qwen-max

# 萤石开放平台
EZVIZ_APP_KEY=your-ezviz-app-key
EZVIZ_APP_SECRET=your-ezviz-app-secret

# 定时任务（开发时设为 false 避免与 uvicorn --reload 冲突）
ENABLE_SCHEDULER=true

# PostgreSQL（生产环境）
PG_HOST=localhost
PG_PORT=5432
PG_USER=edgesys
PG_PASSWORD=change-me
PG_DATABASE=edgesys

# ============ Phase 3 ============
# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# TDengine
TDENGINE_HOST=localhost
TDENGINE_PORT=6030
TDENGINE_USER=root
TDENGINE_PASS=taosdata
TDENGINE_DB=edgefall_iot

# MQTT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=edgefall/device/
